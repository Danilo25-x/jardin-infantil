<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JardinInfantil" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/verde_jardin</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/amarillo_sol</item>
        <item name="colorOnSecondary">@color/texto</item>
        <item name="colorSurface">@color/fondo</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorError">@color/coral_critico</item>
        <item name="colorOnError">@color/blanco</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/blanco</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Accion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fondo_tarjeta</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">72dp</item>
    </style>
</resources>