<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/fondo" android:orientation="vertical">
    <include layout="@layout/encabezado_regreso" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/period" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/fondo_tarjeta" android:clickable="true" android:focusable="true" android:padding="14dp" android:textColor="@color/texto" android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/fondo_tarjeta" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asistencia" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <TextView android:id="@+id/reportRegistered" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/texto" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/reportAttended" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/verde_oscuro" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/reportAbsent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/texto" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Registrados" android:textColor="@color/texto_suave" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Asistieron" android:textColor="@color/texto_suave" android:textSize="12sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Ausentes" android:textColor="@color/texto_suave" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/fondo_tarjeta" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complementación alimentaria" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/reportDelivered" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/verde_oscuro" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/reportPending" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/amarillo_texto" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/fondo_tarjeta" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Inventario actual" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/reportInventory" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/fondo_tarjeta" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Detalle del período" android:textColor="@color/texto" android:textSize="15sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/reportDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>
            <Button android:id="@+id/viewDetail" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/fondo_boton_primario" android:stateListAnimator="@null" android:text="VER DETALLE" android:textColor="@color/blanco" android:textStyle="bold" />
            <Button android:id="@+id/exportReport" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/fondo_boton_secundario" android:stateListAnimator="@null" android:text="COMPARTIR REPORTE" android:textColor="@color/verde_oscuro" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/navegacion_inferior" />
</LinearLayout>
