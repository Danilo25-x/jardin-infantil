<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">
    <include layout="@layout/encabezado_regreso" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <Button android:id="@+id/historyDate" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/fondo_boton_secundario" android:stateListAnimator="@null" android:textColor="@color/verde_oscuro" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Asistencia y entregas" android:textColor="@color/texto" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/historyAttendance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/fondo_tarjeta" android:orientation="vertical" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Alimentación servida" android:textColor="@color/texto" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/historyFeeding" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/fondo_tarjeta" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/navegacion_inferior" />
</LinearLayout>
