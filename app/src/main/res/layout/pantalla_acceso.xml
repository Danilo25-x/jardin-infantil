<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/fondo_logo"
            android:padding="18dp"
            android:src="@drawable/icono_hoja"
            android:tint="@color/blanco"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Jardín Infantil"
            android:textColor="@color/texto"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión y cuidado infantil"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Qué bueno tenerte aquí"
            android:textColor="@color/texto"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ingresa con la cuenta asignada por el jardín."
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Correo electrónico"
            android:textColor="@color/texto"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp">

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_campo"
                android:hint="nombre@institucion.co"
                android:inputType="textEmailAddress"
                android:paddingStart="46dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_suave"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:src="@drawable/icono_correo"
                android:tint="@color/texto_suave"
                android:contentDescription="Correo" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Contraseña"
            android:textColor="@color/texto"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp">

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_campo"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:paddingStart="46dp"
                android:paddingEnd="46dp"
                android:textColor="@color/texto"
                android:textColorHint="@color/texto_suave"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:src="@drawable/icono_candado"
                android:tint="@color/texto_suave"
                android:contentDescription="Contraseña" />

            <ImageView
                android:id="@+id/togglePassword"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/icono_ojo"
                android:tint="@color/texto_suave"
                android:contentDescription="Mostrar contraseña" />
        </FrameLayout>

        <TextView
            android:id="@+id/loginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/coral_texto"
            android:textSize="12sp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_boton_primario"
            android:stateListAnimator="@null"
            android:text="INGRESAR"
            android:textColor="@color/blanco"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icono_seguridad"
                android:tint="@color/verde_oscuro"
                android:contentDescription="Seguridad" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Inicia sesión con la cuenta asignada por el jardín."
                android:textColor="@color/texto_suave"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>




