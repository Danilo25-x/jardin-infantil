<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <include layout="@layout/encabezado_regreso" />

    <TextView
        android:id="@+id/childInitials"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/fondo_circulo_verde"
        android:gravity="center"
        android:textColor="@color/verde_oscuro"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/childName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/childRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/texto_suave"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/fondo_tarjeta"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora actual"
            android:textColor="@color/texto_suave"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/currentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/verde_oscuro"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/fondo_aviso_suave"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/icono_seguridad"
            android:tint="@color/verde_oscuro"
            android:contentDescription="Seguridad" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Verifica el nombre del niño antes de continuar."
            android:textColor="@color/verde_oscuro"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/registerArrival"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/fondo_boton_primario"
        android:stateListAnimator="@null"
        android:text="REGISTRAR LLEGADA"
        android:textColor="@color/blanco"
        android:textStyle="bold" />
</LinearLayout>



